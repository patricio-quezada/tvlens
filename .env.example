# Django
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Production only. With DEBUG off, the app needs SECRET_KEY, redirects to HTTPS,
# and sends secure cookies (see settings.py).
# CSRF_TRUSTED_ORIGINS=https://tvlens.org
# TRUST_PROXY_SSL_HEADER=True   # only if the host sets X-Forwarded-Proto
# SECURE_HSTS_SECONDS=3600      # raise once the deploy is proven

# Database. Leave these commented out to use SQLite at db.sqlite3 in this
# folder. A variable set to an empty value counts as set, so don't leave any
# of them blank.
# DB_ENGINE=django.db.backends.sqlite3
# DB_NAME=/path/to/db.sqlite3

# TMDB API — get a free key at https://www.themoviedb.org/settings/api
TMDB_API_KEY=your-tmdb-api-key-here
